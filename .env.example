# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Hostinger MySQL Database credentials
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false

# Media Storage Domain & Hostinger Upload Service
CHAT_MEDIA_PUBLIC_BASE_URL="https://midia.geracaozpro.com"
HOSTINGER_MEDIA_API_URL="https://midia.geracaozpro.com/api/upload.php"
HOSTINGER_MEDIA_UPLOAD_SECRET=""

# TikTok Integration Credentials (TikTok Login Kit)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://app.geracaozpro.com/api/tiktok/oauth/callback
TIKTOK_ENVIRONMENT=sandbox
TIKTOK_TOKEN_ENCRYPTION_KEY=

# SocialCrawl - Minerador TikTok Shop Brasil
SOCIALCRAWL_API_KEY=
# Cache de buscas para economizar créditos (minutos)
SOCIALCRAWL_CACHE_MINUTES=15
